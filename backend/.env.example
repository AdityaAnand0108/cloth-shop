# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
# Use the SESSION pooler (port 5432). The transaction pooler (6543) breaks Hibernate.
# Region: choose ap-south-1 (Mumbai) when you create the project.

DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password
