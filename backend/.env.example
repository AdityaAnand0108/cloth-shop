# Neon Console -> project -> Connect. Select the pooled option for DB_URL.
# Put the Neon URI host and database name into the JDBC URL shape below; keep the
# username/password in their separate variables. Add sslmode=require.
# Example hostnames are placeholders; copy your own from Neon's Connect dialog.

DB_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Flyway schema migrations should use the direct (non-pooler) Neon endpoint.
DB_MIGRATION_URL=jdbc:postgresql://YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
DB_USER=YOUR_NEON_ROLE
DB_PASSWORD=your-neon-password

# Online deployment only. Set database credentials as provider secrets; never
# commit real values. Neon Auth is configured in the frontend build environment;
# the API endpoints themselves are public.
APP_CORS_ALLOWED_ORIGINS=https://your-shop.pages.dev
