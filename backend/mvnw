#!/bin/sh
# Minimal Maven wrapper. First run downloads Apache Maven into ~/.m2/wrapper
# and reuses it afterwards. Nothing is installed system-wide.
set -e

MVN_VERSION=3.9.9
WRAPPER_HOME="${HOME}/.m2/wrapper"
MVN_HOME="${WRAPPER_HOME}/apache-maven-${MVN_VERSION}"
MVN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MVN_VERSION}/apache-maven-${MVN_VERSION}-bin.zip"

if [ ! -x "${MVN_HOME}/bin/mvn" ]; then
  echo "Maven ${MVN_VERSION} not found locally. Downloading once to ${WRAPPER_HOME} ..."
  mkdir -p "${WRAPPER_HOME}"
  curl -fsSL -o "${WRAPPER_HOME}/maven.zip" "${MVN_URL}"
  unzip -q -o "${WRAPPER_HOME}/maven.zip" -d "${WRAPPER_HOME}"
  rm -f "${WRAPPER_HOME}/maven.zip"
  chmod +x "${MVN_HOME}/bin/mvn"
fi

exec "${MVN_HOME}/bin/mvn" "$@"
